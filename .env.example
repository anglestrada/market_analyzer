# Copy to .env. NEVER commit .env or kalshi.key.

APP_ENV=local
APP_URL=http://localhost:8000          # include a sub-folder if you use one, e.g. http://localhost/kalshi/public
APP_TIMEZONE=America/New_York          # display only; everything is stored in UTC
# LOG_PATH=/var/log/php/app-error.log  # default: that path if writable, else the terminal (stderr)

# Database (your existing names). DATABASE_URL, if set, takes priority.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASS=
# DATABASE_URL=postgres://user:pass@host:5432/dbname
# DB_SSLMODE=prefer

# Personal localhost auto-login (only works from 127.0.0.1 / ::1). DEV_AUTO_LOGIN=0 disables it.
APP_PASS=
USER_ROLE=admin
USER_EMAIL=
USER_ID=                               # should match users.id (bin/create_user.php prints it)
DEV_AUTO_LOGIN=1

# Kalshi
K_KEY=                                 # your API Key ID (UUID)
KALSHI_PRIVATE_KEY_PATH=./kalshi.key   # path to the RSA private key file (relative to this folder or absolute)
# KALSHI_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"   # alternative to the file
KALSHI_USE_AUTH=1                      # 0 = send unsigned requests (market data is public)
KALSHI_BASE_URL=https://external-api.kalshi.com/trade-api/v2
KALSHI_UFC_SERIES=KXUFCFIGHT

# NewsAPI
NEWSAPI_KEY=
